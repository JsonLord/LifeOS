# Load into the service environment; do not commit a populated copy.
LIFEOS_STORAGE_PROVIDER=notion
LIFEOS_STORAGE_CONFIG_PATH=/path/to/storage.toml
NOTION_API_KEY=
NOTION_LIFEOS_ROOT_PAGE_ID=

# Dedicated disposable integration fixture only; never reuse production mappings.
LIFEOS_NOTION_TEST_PAGE_ID=
LIFEOS_NOTION_TEST_DATA_SOURCE_ID=
LIFEOS_NOTION_TEST_TITLE_PROPERTY=Name
